{
  "name": "verifikasi-monorepo",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "init:local": "node scripts/setup.mjs",
    "dev": "pnpm --filter @verifikasi/web dev",
    "lint": "pnpm check:structure && eslint apps/web/src packages/domain/src packages/chain/src packages/credentials/src packages/ocr/src",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "check:structure": "node scripts/check-structure.mjs",
    "check:netlify": "node scripts/check-netlify-functions.mjs",
    "test:e2e": "pnpm --filter @verifikasi/web exec playwright test",
    "db:generate": "pnpm --filter @verifikasi/web db:generate",
    "db:migrate": "pnpm --filter @verifikasi/web db:migrate",
    "test:db": "pnpm --filter @verifikasi/web test:db"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "^16.2.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "0.28.1",
    "eslint": "^10.11.0",
    "toml": "^5.0.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "3.2.7",
    "yauzl": "^3.4.0"
  }
}
