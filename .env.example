# Demo: real OCR uploads fail closed before blockchain; synthetic examples are labelled.
APP_MODE=demo
APP_ORIGIN=http://localhost:3000
# Public project identifier for RainbowKit mobile/QR connections (Reown dashboard).
# Optional for installed browser wallets. Rebuild after changing this value.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Local demo may leave this empty. Vercel, Netlify and testnet require PostgreSQL.
# Neon runtime: copy the pooled URL from the target branch's Connect dialog.
# Keep credentials server-side. Encode special characters in the password.
DATABASE_URL=
# Migration CLI only: Neon direct/unpooled URL for the same database and branch.
# Apply pnpm db:migrate before starting the app; runtime never creates tables.
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=1
# Filesystem fallback for local demo; unused for files when STORAGE_PROVIDER=neon.
PRIVATE_DATA_DIR=.private-data
# Neon Object Storage is used locally and on any app host, including Netlify.
# Set NEON_STORAGE_* for the same branch as DATABASE_URL. Keep them server-side.
# For an offline demo, set STORAGE_PROVIDER=local and leave S3_BUCKET empty.
STORAGE_PROVIDER=neon
# Optional alternative: STORAGE_PROVIDER=netlify uses Netlify Blobs.
NETLIFY_BLOBS_STORE=verifikasi-private
# Only for local/external access. Netlify Functions supply their own credentials.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
# Optional legacy Vercel Blob storage (ignored when Neon storage is selected).
BLOB_READ_WRITE_TOKEN=
# Exact hostname, without scheme/path, e.g. storeid.private.blob.vercel-storage.com
BLOB_STORE_HOSTNAME=
# Required by /api/internal/maintenance; separate random secret, >=32 characters.
CRON_SECRET=
# Rate-limit source: Netlify (x-nf-client-connection-ip) and Vercel (x-vercel-forwarded-for) are detected
# automatically. Set true only behind one other trusted reverse proxy (rightmost X-Forwarded-For entry is used).
TRUST_PROXY=false
# Global cap on FHE comparison transactions paid by the relayer per hour (all instances).
MAX_COMPARISONS_PER_HOUR=30

# Sepolia configuration. Never use NEXT_PUBLIC_ for any service secret.
RPC_URL=
CHAIN_ID=11155111
CHAIN_CONFIRMATIONS=2
CREDENTIAL_CONTRACT_ADDRESS=
CONTRACT_DEPLOYMENT_BLOCK=0
# Read-only support for records on an earlier protocol v1 contract: "0xAddress:cutoffBlock". Records issued
# after the cutoff block are not trusted. Leave empty when no legacy contract is kept.
LEGACY_CREDENTIAL_CONTRACTS=
RELAYER_PRIVATE_KEY=
ATTESTOR_PRIVATE_KEY=
RESULT_READER_PRIVATE_KEY=
# The three service keys must belong to three different addresses that hold only their own role and
# are neither administrator nor institution signer; the backend refuses to submit otherwise.
# Relayer Zama Sepolia terbuka dan tidak memerlukan API key.
# Deploy only; separate administrator and service wallets.
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=
ATTESTOR_ADDRESS=
RELAYER_ADDRESS=
RESULT_READER_ADDRESS=
# Deploy preflight only: comma-separated institution signer addresses.
# These public addresses must differ from admin and all service roles.
PLANNED_SIGNER_ADDRESSES=
# Optional source verification in Etherscan; Sourcify API v2 needs no API key.
ETHERSCAN_API_KEY=

# Private Neon bucket declared in neon.ts. Also used by the generic S3 adapter.
S3_BUCKET=verifikasi-private
# Neon storage reads only NEON_STORAGE_*, locally and on Netlify (which reserves AWS_* names).
# Copy the matching AWS_* values from Neon CLI's ignored storage env file into these aliases.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
# Generic S3 adapter only; ignored when STORAGE_PROVIDER=neon.
S3_ENDPOINT=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
