# Demo: real OCR uploads fail closed before blockchain; synthetic examples are labelled.
APP_MODE=demo
APP_ORIGIN=http://localhost:3000
# Public project identifier for RainbowKit mobile/QR connections (Reown dashboard).
# Optional for installed browser wallets. Rebuild after changing this value.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Local demo may leave this empty. Vercel, Netlify and testnet require PostgreSQL.
# Supabase runtime: copy the Transaction pooler URL (port 6543) from Connect.
# Keep credentials server-side. Encode special characters in the password.
DATABASE_URL=
# Migration CLI only: Supabase direct or Session pooler URL (port 5432).
# Apply pnpm db:migrate before starting the app; runtime never creates tables.
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=1
# Local demo only; hosted sessions must use PostgreSQL, not temporary files.
PRIVATE_DATA_DIR=.private-data
# Netlify hosting automatically uses Netlify Blobs; no Vercel Blob token is needed.
# Set STORAGE_PROVIDER=netlify only to access Netlify Blobs from local/external workers.
STORAGE_PROVIDER=
NETLIFY_BLOBS_STORE=verifikasi-private
# Only for local/external access. Netlify Functions supply their own credentials.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
# Optional legacy Vercel hosting: private Blob storage (ignored on Netlify).
BLOB_READ_WRITE_TOKEN=
# Exact hostname, without scheme/path, e.g. storeid.private.blob.vercel-storage.com
BLOB_STORE_HOSTNAME=
# Required by /api/internal/maintenance; separate random secret, >=32 characters.
CRON_SECRET=
# Rate-limit source: Netlify (x-nf-client-connection-ip) and Vercel (x-vercel-forwarded-for) are detected
# automatically. Set true only behind one other trusted reverse proxy (rightmost X-Forwarded-For entry is used).
TRUST_PROXY=false
# Global cap on FHE comparison transactions paid by the relayer per hour (all instances).
MAX_COMPARISONS_PER_HOUR=30

# Sepolia configuration. Never use NEXT_PUBLIC_ for any service secret.
RPC_URL=
CHAIN_ID=11155111
CHAIN_CONFIRMATIONS=2
CREDENTIAL_CONTRACT_ADDRESS=
CONTRACT_DEPLOYMENT_BLOCK=0
RELAYER_PRIVATE_KEY=
ATTESTOR_PRIVATE_KEY=
RESULT_READER_PRIVATE_KEY=
# The three service keys must belong to three different addresses that hold only their own role and
# are neither administrator nor institution signer; the backend refuses to submit otherwise.
# Relayer Zama Sepolia terbuka dan tidak memerlukan API key.
# Deploy only; separate administrator and service wallets.
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=
ATTESTOR_ADDRESS=
RELAYER_ADDRESS=
RESULT_READER_ADDRESS=

# Optional PRIVATE S3-compatible storage. No public bucket policy.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
