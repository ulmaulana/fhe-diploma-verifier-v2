// Temporary reproduction of S-04 against the pre-fix contract. Not part of the suite.
const assert = require('node:assert/strict');
const { ethers, fhevm } = require('hardhat');

describe('S-04 reproduction (pre-fix contract)', function () {
  it('rename between e-sign and inclusion stores a name hash that differs from the signed profile', async () => {
    assert.equal(fhevm.isMock, true);
    const [admin, issuer, attestor, relayer, reader] = await ethers.getSigners();
    const contract = await ethers.deployContract('VerifikasiIjazah', [admin.address, attestor.address, relayer.address, reader.address]);
    const address = await contract.getAddress();
    const issuerId = ethers.hexlify(ethers.randomBytes(32));
    const reviewedName = 'Universitas Contoh — sintetis';
    await (await contract.setIssuer(issuerId, reviewedName, true)).wait();
    await (await contract.setSigner(issuerId, issuer.address, true)).wait();
    const builder = fhevm.createEncryptedInput(address, issuer.address);
    for (let i = 0; i < 4; i++) builder.add256(BigInt(i + 1));
    const encrypted = await builder.encrypt();
    const nonce = 11n;
    const payload = {
      credentialId: await contract.credentialIdFor(issuerId, issuer.address, nonce), issuerId, signer: issuer.address,
      // publicDataHash commits to a profile whose issuerDisplayName is reviewedName.
      publicDataHash: ethers.id('profile with ' + reviewedName),
      encryptedAttributesHash: ethers.keccak256(ethers.AbiCoder.defaultAbiCoder().encode(['uint32', 'bytes32[4]'], [1, encrypted.handles])),
      schemaVersion: 1, encodingVersion: 1, disclosurePolicyVersion: 1, nonce,
      issuanceDeadline: (await ethers.provider.getBlock('latest')).timestamp + 600,
    };
    const types = { CredentialAuthorization: [['credentialId', 'bytes32'], ['issuerId', 'bytes32'], ['signer', 'address'],
      ['publicDataHash', 'bytes32'], ['encryptedAttributesHash', 'bytes32'], ['schemaVersion', 'uint32'], ['encodingVersion', 'uint32'],
      ['disclosurePolicyVersion', 'uint32'], ['nonce', 'uint256'], ['issuanceDeadline', 'uint256']].map(([name, type]) => ({ name, type })) };
    const signature = await issuer.signTypedData({ name: 'VerifikasiIjazah', version: '1', chainId: 31337, verifyingContract: address }, types, payload);
    // The administrator renames the institution while the issuance transaction is pending.
    await (await contract.setIssuer(issuerId, 'Nama Kampus Baru', true)).wait();
    await (await contract.connect(issuer).issueCredential(payload, signature, encrypted.handles, encrypted.inputProof)).wait();
    const stored = (await contract.getCredential(payload.credentialId)).issuerNameHash;
    console.log('      signed profile name hash :', ethers.keccak256(ethers.toUtf8Bytes(reviewedName)));
    console.log('      stored issuerNameHash    :', stored);
    // The issuance succeeded, but the record can never match its own e-signed profile (permanent INVALID_PROOF).
    assert.notEqual(stored, ethers.keccak256(ethers.toUtf8Bytes(reviewedName)));
  });
});
