const {ethers}=require('ethers');
(async()=>{const p=new ethers.JsonRpcProvider(process.env.RPC_URL);
if((await p.getNetwork()).chainId!==11155111n) throw new Error('not sepolia');
const w=new ethers.Wallet(process.env.DEPLOYER_PRIVATE_KEY,p);
for(const [label,to,eth] of [['relayer','0xea36d9628c7CaCa078FbD0a9164A5cF0FAc52933','0.25'],['institution signer','0x399a8A182631de9389B3fB3488537c9461d3a43e','0.1']]){
 const tx=await w.sendTransaction({to,value:ethers.parseEther(eth)});const r=await tx.wait(2);
 console.log(JSON.stringify({label,from:w.address,to,valueEth:eth,transactionHash:r.hash,blockNumber:r.blockNumber,status:r.status}));}
for(const a of ['0xea36d9628c7CaCa078FbD0a9164A5cF0FAc52933','0x399a8A182631de9389B3fB3488537c9461d3a43e',w.address]) console.log('balance',a,ethers.formatEther(await p.getBalance(a)));
})().catch(e=>{console.error('ERR',e.shortMessage||e.code);process.exit(1)})
