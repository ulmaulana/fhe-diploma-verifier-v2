{
  "name": "@verifikasi/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-web.mjs dev",
    "build": "node ../../scripts/run-web.mjs build && node ../../scripts/check-deployment.mjs",
    "start": "node ../../scripts/run-web.mjs start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:vercel": "pnpm --filter @verifikasi/contracts build && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "vitest run --config vitest.database.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@fontsource/hind": "5.3.0",
    "@netlify/blobs": "^11.1.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.103.2",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/ind": "1.0.0",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.9",
    "@verifikasi/chain": "workspace:*",
    "@verifikasi/credentials": "workspace:*",
    "@verifikasi/domain": "workspace:*",
    "@verifikasi/ocr": "workspace:*",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/svm": "2.25.0",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "drizzle-orm": "0.45.3",
    "ethers": "^6.16.0",
    "mupdf": "1.28.1",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tesseract.js": "7.0.0",
    "viem": "2.56.8",
    "wagmi": "2.19.5",
    "workflow": "4.8.9",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@verifikasi/config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
